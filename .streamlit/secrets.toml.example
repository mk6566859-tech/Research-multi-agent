# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and replace with your actual keys.
# DO NOT COMMIT secrets.toml TO GITHUB!

# Required: Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Required: Your Tavily Search API key from https://app.tavily.com
TAVILY_API_KEY = "tvly-your_tavily_api_key_here"

# Optional: Groq LLM model identifier (defaults to openai/gpt-oss-120b)
GROQ_MODEL = "openai/gpt-oss-120b"
